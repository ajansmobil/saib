{
  "name": "Dernek Üyelik Formu",
  "description": "Dernek ve vakıf yapıları için nüfus, eğitim, şirket ve referans bilgilerini toplayan kapsamlı üyelik başvuru formu modülü. PDF form görünümünü tarayıcıda yeniden oluşturur, çok kolonlu satırlar, onay kutuları ve numaralı referans alanları içerir.",
  "version": "1.1.0",
  "icon": "approval_delegation",
  "category": "form",
  "desing": {
    "texts": {
      "organization": {
        "tr": "Uluslararası İş İnsanları Derneği",
        "en": "International Business Association"
      },
      "formTitle": {
        "tr": "Üyelik Başvuru Formu",
        "en": "Membership Application Form"
      },
      "formSubtitle": {
        "tr": "Lütfen kişisel ve firma bilgilerinizi eksiksiz doldurunuz.",
        "en": "Please fill in your personal and company information completely."
      },
      "formFooter": {
        "tr": "Formu kaydettikten sonra dernek yönetimi başvurunuzu değerlendirecektir.",
        "en": "After submitting the form, the association board will review your application."
      },
      "submit": {
        "tr": "Başvuruyu Gönder",
        "en": "Submit Application"
      },
      "submitting": {
        "tr": "Başvurunuz gönderiliyor...",
        "en": "Submitting your application..."
      },
      "success": {
        "tr": "Başvurunuz başarıyla alındı. En kısa sürede sizinle iletişime geçilecektir.",
        "en": "Your application has been received. We will contact you as soon as possible."
      },
      "error": {
        "tr": "Başvurunuz gönderilirken bir hata oluştu. Lütfen tekrar deneyin.",
        "en": "An error occurred while sending your application. Please try again."
      },
      "loginRequired": {
        "tr": "Başvuru göndermek için giriş yapmalısınız.",
        "en": "You need to sign in to submit the application."
      },
      "waiting": {
        "tr": "Form hazırlanıyor, lütfen bekleyiniz.",
        "en": "Preparing the form, please wait."
      }
    }
  },
