      "desing": {
        "name": {
          "tr": "SAİB'i Tanıyın",
          "en": "Get to Know SAIB",
          "ar": "تعرف على سايب"
        },
        "name2": {
          "tr": "Vizyonumuz",
          "en": "Our Vision",
          "ar": "رؤيتنا"
        },
        "spot2": {
          "tr": "Türkiye ve Suriye arasında kalıcı ticari köprüler kurarak, uluslararası pazarlarda güçlü bir ekonomik iş birliği ağı oluşturmak.",
          "en": "To establish permanent commercial bridges between Turkey and Syria, creating a strong network of economic cooperation in international markets.",
          "ar": "إنشاء جسور تجارية دائمة بين تركيا وسوريا، وإنشاء شبكة قوية من التعاون الاقتصادي في الأسواق الدولية."
        },
        "icon2": "home",
        "name3": {
          "tr": "Misyonumuz",
          "en": "Our Mission",
          "ar": "مهمتنا"
        },
        "spot3": {
          "tr": "Üretim, yatırım ve ihracat potansiyelini artırmak; sanayici, bilim insanı ve iş insanlarını ortak bir teşkilatta birleştirip, bölgesel kalkınmayı hızlandırmak.",
          "en": "To increase production, investment and export potential; to unite industrialists, scientists and business people in a common organization and accelerate regional development.",
          "ar": "زيادة إمكانات الإنتاج والاستثمار والتصدير؛ توحيد الصناعيين والعلماء ورجال الأعمال في منظمة مشتركة وتسريع التنمية الإقليمية."
        },
        "icon3": "home",
        "img": "logo.jpg",
        "bgcolor": "#85260f",
        "fontcolor": "#fff",
        "margintop": "20",
        "marginbotton": "20",
        "description": {
          "tr": "Company olarak 25 yıldır profesyonel personel kadromuz ile ithalat, ihracat, danışmanlık, lojistik ve transit ticaret alanlarında hizmet sunmaktan onur duyuyoruz. Ürünü olsun ya da olmasın, tüm firmalar için profesyonel ve kurumsal danışmanlık hizmeti sunarak firmaların etkin şekilde ithalat ya da ihracat yapmalarını sağlıyoruz.",
          "en": "",
          "ar": ""
        }
      },
